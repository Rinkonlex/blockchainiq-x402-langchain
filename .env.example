# Copy to .env and fill in. NEVER commit a real key.
# Wallet holding a little USDC on Base (settlement is gasless for the payer;
# the $0.01 brief call needs $0.01 USDC, no ETH). Use a dedicated wallet
# with a small balance, never a main wallet.
AGENT_PRIVATE_KEY=0x...
# Optional: refuse any single payment above this many USD (default 0.60;
# the dearest Blockchain IQ call is $0.50).
MAX_USD_PER_CALL=0.60
